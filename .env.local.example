# ─── E-Book Studio — Universal AI Provider Configuration ────────────────────
# Copy this file to .env.local and populate the keys for the providers you wish to use.
# Any model whose key is not configured will gracefully report a helpful error in the UI.

# 1. Google Gemini (Gemini 1.5 Flash, Gemini 2.0 Flash, Gemini 1.5 Pro)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (GPT-4o, GPT-4o-mini)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude (Claude 3.5 Sonnet)
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. DeepSeek (DeepSeek-V3, DeepSeek-R1)
# Get key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
